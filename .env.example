# Binance Testnet — use spot/futures testnet keys only; never commit real .env
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_SPOT_TESTNET_BASE_URL=https://testnet.binance.vision
BINANCE_FUTURES_TESTNET_BASE_URL=https://testnet.binancefuture.com

# App
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://crypto:crypto@localhost:5432/crypto_quant
REDIS_URL=redis://localhost:6379/0

# JWT (change in any shared/staging environment)
JWT_SECRET=change-me-to-a-long-random-string
