# Binance 现货
# 三选一（也可不设 BINANCE_SPOT_TRADING_ENV，仅用下面 BINANCE_USE_TESTNET 兼容旧行为）：
#   testnet — 官方测试网 https://testnet.binance.vision
#   demo    — 现货模拟交易 https://demo-api.binance.com （密钥在 https://demo.binance.com 创建）
#   live    — 主网 https://api.binance.com
BINANCE_SPOT_TRADING_ENV=demo
BINANCE_USE_TESTNET=true
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_MARKET_STREAM_ENABLED=true
BINANCE_USER_STREAM_ENABLED=true
BINANCE_SPOT_TESTNET_BASE_URL=https://testnet.binance.vision
BINANCE_SPOT_DEMO_BASE_URL=https://demo-api.binance.com
BINANCE_SPOT_LIVE_BASE_URL=https://api.binance.com
# 可选：强制 REST 根（会覆盖上面环境选择）
# BINANCE_SPOT_REST_BASE_OVERRIDE=

# App
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://crypto:crypto@localhost:5432/crypto_quant
REDIS_URL=redis://localhost:6379/0

# JWT (change in any shared/staging environment)
JWT_SECRET=change-me-to-a-long-random-string
